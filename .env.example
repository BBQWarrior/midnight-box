# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# --- Server ---
PORT=8080
# 0.0.0.0 = reachable from phones on your network
HOST=0.0.0.0
# Optional: override the URL encoded in the QR code (auto-detected LAN IP otherwise)
# PUBLIC_URL=http://192.168.1.50:8080

# --- Spotify ---
# Create an app at https://developer.spotify.com/dashboard
# Add this exact Redirect URI in the app settings: http://127.0.0.1:8080/auth/spotify/callback
# Midnight Box uses the PKCE flow, so no client secret is needed.
SPOTIFY_CLIENT_ID=

# --- Queue rules ---
# These are the defaults. The host can change all of them while the party runs (host panel, Rules),
# and those changes are kept until the host resets them.
# Songs a single guest can have waiting in the queue at once
MAX_PENDING_PER_GUEST=3
# Max songs a guest can add in one go
MAX_PER_REQUEST=3
# Each guest can add at most GUEST_WINDOW_SONGS songs per GUEST_WINDOW_MINUTES (rolling)
GUEST_WINDOW_SONGS=2
GUEST_WINDOW_MINUTES=20
# Minutes before the same song can be requested again, counted from when it started playing.
# 0 turns it off.
SONG_COOLDOWN_MINUTES=120
# At most ARTIST_MAX_SONGS songs by the same main artist per ARTIST_COOLDOWN_MINUTES (rolling).
# With 1, an artist rests for the whole time after each song. 0 minutes turns it off.
ARTIST_MAX_SONGS=1
ARTIST_COOLDOWN_MINUTES=20

# --- Vote rounds ---
# While the queue is short, guests vote on songs related to what's playing; the winner is queued.
# Suggestions come from Last.fm. Get a free API key at https://www.last.fm/api/account/create
# (only the "API key" is needed, not the shared secret). Without one, vote rounds stay off.
LASTFM_API_KEY=
# Seconds per round
VOTE_ROUND_SECONDS=30
# Rounds run while fewer than this many songs are waiting
VOTE_WHEN_FEWER_THAN=2

# The host password is NOT configured here: you set it on first run in the host panel
# (on the host computer), and it's stored hashed in the local database.
# Forgot it? Run: npm run reset-password
