# Copy this file to .env and fill it in. .env is git-ignored: never commit it.

# --- Server ---
PORT=8080
# 0.0.0.0 = reachable from phones on your network
HOST=0.0.0.0
# Optional: override the URL encoded in the QR code (auto-detected LAN IP otherwise)
# PUBLIC_URL=http://192.168.1.50:8080

# --- Spotify ---
# Create an app at https://developer.spotify.com/dashboard
# Add this exact Redirect URI in the app settings: http://127.0.0.1:8080/auth/spotify/callback
# Midnight Box uses the PKCE flow, so no client secret is needed.
SPOTIFY_CLIENT_ID=

# --- Queue rules ---
# Songs a single guest can have waiting in the queue at once
MAX_PENDING_PER_GUEST=3
# Max songs a guest can add in one go
MAX_PER_REQUEST=3
