{
  "name": "@midnight-box/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts --dev",
    "dev:demo": "tsx watch src/index.ts --dev --demo",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node26 --packages=external --outfile=dist/index.js",
    "start": "node dist/index.js",
    "start:demo": "node dist/index.js --demo",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "reset-password": "tsx src/index.ts --reset-host-password"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "fastify": "^5.12.8",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
